# -------- Clean physiological measurements --------

phys_cols = [
    'HR(bpm)',
    'SpO2(%)',
    'PI(%)',
    'RR(rpm)',
    'PR(bpm)'
]

param_df.columns = param_df.columns.str.strip()

for col in phys_cols:

    # Convert to ordinary Python strings first
    values = param_df[col].to_numpy(dtype=object)

    # Convert measurements to numeric values
    numeric_values = pd.to_numeric(
        values,
        errors='coerce'
    )

    # Store values explicitly as float64
    param_df[col] = np.asarray(
        numeric_values,
        dtype=np.float64
    )

    # Report missing or invalid measurements
    n_missing = param_df[col].isna().sum()

    print(f"{col}: {n_missing} missing/invalid values")

